# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=core_santiago
DB_USER=postgres
DB_PASSWORD=

# Directorio donde estan los PDFs por año (sesiones/2024/, sesiones/2025/, ...)
# Por defecto: <raiz del proyecto>/sesiones
SESIONES_DIR=

# Claude API (clave sk-ant-... desde https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# URL base de la webapp (informativa, para futuras notificaciones)
WEBAPP_BASE_URL=http://localhost:3003
